<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <Button
            android:id="@+id/previous"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/track_previous"
            android:text="@string/arrow_previous" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Medium" />

        <Button
            android:id="@+id/next"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/track_next"
            android:text="@string/arrow_next" />

        <Button
            android:id="@+id/settings"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/settings"
            android:text="@string/gear"
            android:textSize="22sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tracking_off"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/banner"
        android:gravity="center"
        android:padding="12dp"
        android:text="@string/tracking_off"
        android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small"
        android:textColor="#4E342E"
        android:visibility="gone" />

    <RadioGroup
        android:id="@+id/spans"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <RadioButton
            android:id="@+id/span_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/span_1" />

        <RadioButton
            android:id="@+id/span_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/span_2" />

        <RadioButton
            android:id="@+id/span_7"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/span_7" />

        <RadioButton
            android:id="@+id/span_30"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/span_30" />
    </RadioGroup>

    <TextView
        android:id="@+id/summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

    <Switch
        android:id="@+id/modes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:paddingHorizontal="16dp"
        android:text="@string/modes_switch"
        android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

    <io.github.cryptid11.gps.TrackView
        android:id="@+id/track"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/detail"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:minHeight="64dp"
            android:padding="12dp"
            android:textAppearance="@android:style/TextAppearance.DeviceDefault.Small" />

        <Button
            android:id="@+id/share"
            style="@android:style/Widget.DeviceDefault.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/share_button" />
    </LinearLayout>
</LinearLayout>
